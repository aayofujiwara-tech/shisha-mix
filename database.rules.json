{
  "rules": {
    "recipes": {
      ".read": "(auth != null && query.orderByChild == 'userId' && query.equalTo == auth.uid) || (query.orderByChild == 'isPublic' && query.equalTo == true)",
      "$recipeId": {
        ".read": "data.child('isPublic').val() === true || auth.uid === data.child('userId').val()",
        ".write": "auth != null && (auth.uid === data.child('userId').val() || auth.uid === newData.child('userId').val() || (newData.hasChild('likes') && !newData.hasChildren(['title', 'flavors'])))",
        ".validate": "!newData.hasChildren(['title', 'userId']) || (newData.hasChildren(['title', 'userId']) && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 100)",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "description": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)"
        },
        "userId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "likes": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "comments": {
      "$recipeId": {
        ".read": true,
        "$commentId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['text', 'userId', 'createdAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "userId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "ratings": {
      "$recipeId": {
        ".read": true,
        "$userId": {
          ".write": "auth.uid === $userId"
        }
      }
    },
    "likes": {
      "$recipeId": {
        ".read": true,
        "$userId": {
          ".write": "auth.uid === $userId"
        }
      }
    },
    "inventory": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth.uid === $userId"
      }
    },
    "stores": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "sessions": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "user-likes": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "diaries": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    }
  }
}
