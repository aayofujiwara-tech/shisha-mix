{
  "rules": {
    "recipes": {
      ".read": "(auth != null && query.orderByChild == 'userId' && query.equalTo == auth.uid) || (query.orderByChild == 'isPublic' && query.equalTo == true)",
      "$recipeId": {
        ".read": "data.child('isPublic').val() === true || auth.uid === data.child('userId').val()",
        ".write": "auth.uid === newData.child('userId').val() || auth.uid === data.child('userId').val()",
        "likes": {
          ".write": "auth != null"
        }
      }
    },
    "comments": {
      "$recipeId": {
        ".read": true,
        "$commentId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "!newData.child('text').exists() || newData.child('text').val().length <= 200"
        }
      }
    },
    "ratings": {
      "$recipeId": {
        ".read": true,
        "$userId": {
          ".write": "auth.uid === $userId"
        }
      }
    },
    "likes": {
      "$recipeId": {
        ".read": true,
        "$userId": {
          ".write": "auth.uid === $userId"
        }
      }
    },
    "inventory": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "stores": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "sessions": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    },
    "user-likes": {
      "$userId": {
        ".read": "auth.uid === $userId",
        ".write": "auth.uid === $userId"
      }
    }
  }
}
